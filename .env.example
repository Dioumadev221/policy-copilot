# --- Database (Neon / Supabase / Render Postgres: any Postgres 15+ with pgvector) ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/rag

# --- Mode ---
# local     : no API key, hashing embeddings + extractive answers (demo / CI)
# openai    : best quality (recommended for production)
# anthropic : Claude for routing + answers (embeddings still need openai or local)
LLM_PROVIDER=local
EMBEDDING_PROVIDER=local
EMBEDDING_DIM=1536

OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4.1-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
ANTHROPIC_API_KEY=
ANTHROPIC_CHAT_MODEL=claude-opus-5-5
# Optional cross-encoder reranker
COHERE_API_KEY=

# Protects POST/DELETE /documents when set
API_KEY=

# Refusal gate: below this relevance the assistant says "not in the documents".
# Tune with `python -m evals.run` after switching embedding provider.
MIN_RELEVANCE=0.45
